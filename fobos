[project]
name       = GIDEON
version    = VERSION
summary    = Generated Interpolations and Derivatives, Exact to Order N: finite-difference and finite-volume stencil operators for HPC
repository = https://github.com/szaghi/GIDEON
website    = https://szaghi.github.io/GIDEON
email      = stefano.zaghi@gmail.com
year       = 2026
authors    = Stefano Zaghi

# fobis scaffold: the CI runs in the fortran-toolchains images; the matrix builds tests-$TOOLCHAIN_FAMILY
# (gnu, nvf, intel) on every Linux vendor and runs scripts/run_tests.sh
[scaffold]
toolchain = linux-gnu
matrix    = linux-gnu linux-nvhpc linux-oneapi
fpm       = true

# fobis ecosystem check: what proves this project still works against a dependency's working copy
[ecosystem]
check = fobis fetch
        fobis build --mode tests-gnu
        bash scripts/run_tests.sh

# PENF is compiled from its sources by the compiler of the mode (no per-compiler PENF build to keep in step).
# FUNDAL and SELAH serve the tests only (SELAH issue #2: the time integrators of the tests come from SELAH, the one
# source of the time operators): the library modes build gideon.F90's tree, which uses neither. fobis fetch is not
# recursive, so SELAH's own dependencies (PENF, FUNDAL) are listed here
[dependencies]
deps_dir = src/third_party
PENF     = https://github.com/szaghi/PENF :: branch=master
FUNDAL   = https://github.com/szaghi/FUNDAL :: branch=main
SELAH    = https://github.com/szaghi/SELAH :: branch=main

[modes]
# the first mode is the default (fobis build, scripts/install.sh): the library any gfortran can build
modes = static-gnu shared-gnu
        static-nvf shared-nvf
        static-intel shared-intel
        tests-gnu tests-gnu-debug tests-gnu-coverage
        tests-nvf tests-nvf-debug tests-nvf-oac static-selah-nvf static-selah-nvf-r4
        tests-intel tests-intel-debug
        static-gnu-r4 shared-gnu-r4 static-nvf-r4 shared-nvf-r4 static-intel-r4 shared-intel-r4
        tests-gnu-r4 tests-gnu-debug-r4 tests-nvf-r4 tests-nvf-oac-r4 tests-intel-r4
        tests-gnu-r16
        bench-nvf-oac bench-nvf bench-gnu
        bench-compact-nvf-oac bench-compact-nvf bench-compact-gnu
        examples-gnu examples-gnu-r4

[common-variables]
$EXDIRS = PENF/src/tests/ PENF/src/third_party/ PENF/scripts/ PENF/docs/
          FUNDAL/src/tests/ FUNDAL/src/examples/ FUNDAL/docs/ FUNDAL/compilers_proofs/ FUNDAL/scripts/
          SELAH/src/tests/ SELAH/src/bench/ SELAH/src/third_party/ SELAH/docs/ SELAH/scripts/ SELAH/notes/
$STD_GNU = -std=f2018
$STD_INT = -standard-semantics -std18
# ifx's default fp-model (fast=1) reassociates inlined arithmetic: the pair form's exact symmetries and the bitwise
# equality with ADAM (7 curl values 1 ulp off) need the operations as written
$FP_INT  = -fp-model=precise
# nvfortran's -fast vectorises for the CPU that compiles (-tp=host): the CI runners are a mix of CPUs, and on some the
# longer sums are reordered and the bitwise equality with ADAM breaks at s = 4, 5 (-Kieee alone fixed one runner, not
# all: 2026-11-17, 27 values off on a runner the developer's AVX2 CPU never reproduced). The test modes therefore use
# strict IEEE and a fixed target, haswell (AVX2 + FMA, every x86-64 CI runner has it), so that every machine compiles
# the same code; the libraries and the benchmarks keep -fast alone, tuned for their host.
$FP_NVF = -Kieee -tp=haswell
# NVIDIA compute capability of the OpenACC modes; override with --varset (e.g. --varset cc90)
$GPU_CC = cc89

[varset:cc80]
$GPU_CC = cc80

[varset:cc89]
$GPU_CC = cc89

[varset:cc90]
$GPU_CC = cc90

# CNR-IAC medooza's A30 nodes: their drivers (545, 575) cannot run CUDA 13, so cc80 with CUDA 12.9 (as SELAH's)
[varset:iac]
$GPU_CC = cc80,cuda12.9

# ── library modes ────────────────────────────────────────────────────────────
[static-gnu]
help      = Static library, gfortran, optimised
template  = template-lib-static template-gnu template-release
build_dir = lib/gnu/static/

[shared-gnu]
help      = Shared library, gfortran, optimised
template  = template-lib-shared template-gnu template-release
cflags    = -c -fPIC $STD_GNU
build_dir = lib/gnu/shared/

[static-nvf]
help      = Static library, nvfortran, optimised
template  = template-lib-static template-nvf template-release
build_dir = lib/nvf/static/

[shared-nvf]
help      = Shared library, nvfortran, optimised
template  = template-lib-shared template-nvf template-release
cflags    = -c -fPIC
build_dir = lib/nvf/shared/

[static-intel]
help      = Static library, ifx, optimised
template  = template-lib-static template-intel-release template-intel
build_dir = lib/intel/static/

[shared-intel]
help      = Shared library, ifx, optimised
template  = template-lib-shared template-intel
cflags    = -c -fPIC -O3 $STD_INT $FP_INT
build_dir = lib/intel/shared/

# ── test modes: every program of src/tests into exe/, run by scripts/run_tests.sh ──
[tests-gnu]
help      = Tests, gfortran, optimised (fortran-toolchains matrix: family gnu)
template  = template-tests template-gnu template-release

[tests-gnu-debug]
help      = Tests, gfortran, all checks on
template  = template-tests template-gnu template-debug

[tests-gnu-coverage]
help      = Tests, gfortran, coverage instrumentation (rule makecoverage)
template  = template-tests template-gnu
build_profile = coverage

[tests-nvf]
help      = Tests, nvfortran, optimised, CPU (fortran-toolchains matrix: family nvf)
template  = template-tests template-nvf template-release
cflags    = -c $FP_NVF

[tests-nvf-debug]
help      = Tests, nvfortran, all checks on
template  = template-tests template-nvf template-debug
cflags    = -c $FP_NVF

[static-selah-nvf]
help      = SELAH's static library from src/third_party/SELAH, nvfortran, optimised, host (no -acc): the time integrator
            of the OpenACC tests, whose fields are host memory
template  = template-nvf template-release
target    = src/third_party/SELAH/src/lib/selah.F90
mklib     = static
output    = libselah.a
build_dir = lib/nvf/static-selah/
cflags    = -c $FP_NVF
include   = src/third_party/FUNDAL/src/lib/
preproc   = -DFUNDAL_NO_MPI
# off: FoBiS 3.8 reads a dependon's module directory from its output, and the heritage notice would be read with it
cflags_heritage = False

[static-selah-nvf-r4]
help      = SELAH's static library from src/third_party/SELAH, nvfortran, optimised, host (no -acc), R4P: the time integrator
            of the OpenACC tests in single precision, whose fields are host memory
template  = template-nvf template-release
target    = src/third_party/SELAH/src/lib/selah.F90
mklib     = static
output    = libselah.a
build_dir = lib/nvf/static-selah-r4/
cflags    = -c $FP_NVF
include   = src/third_party/FUNDAL/src/lib/
preproc   = -DFUNDAL_NO_MPI -D_R_P_IS_R4P
# off: FoBiS 3.8 reads a dependon's module directory from its output, and the heritage notice would be read with it
cflags_heritage = False

[tests-nvf-oac]
help      = Tests, nvfortran, OpenACC on the GPU of compute capability $GPU_CC
template  = template-tests template-nvf template-release
cflags    = -c -acc -gpu=$GPU_CC -Minfo=accel $FP_NVF
lflags    = -acc -gpu=$GPU_CC
# the time integrator of the programs that use it: SELAH built for the host (their fields are host memory),
# linked; under -acc without its device build SELAH's directives would not compile (FUNDAL's host branch)
dependon  = fobos:static-selah-nvf
exclude_dirs = $EXDIRS src/third_party/SELAH/ src/third_party/FUNDAL/

[tests-intel]
help      = Tests, ifx, optimised (fortran-toolchains matrix: family intel)
template  = template-tests template-intel-release template-intel

[tests-intel-debug]
help      = Tests, ifx, all checks on
template  = template-tests template-intel template-debug

# ── benchmark modes: src/bench/gideon_bench_adam.F90 into exe-bench/ (not a test: scripts/run_tests.sh ignores it) ──
[bench-nvf-oac]
help      = Benchmark against ADAM, nvfortran, OpenACC on the GPU of compute capability $GPU_CC (set CUDA_VISIBLE_DEVICES)
template  = template-bench template-nvf template-release
cflags    = -c -acc -gpu=$GPU_CC -Minfo=accel
lflags    = -acc -gpu=$GPU_CC

[bench-nvf]
help      = Benchmark against ADAM, nvfortran, one CPU core
template  = template-bench template-nvf template-release

[bench-gnu]
help      = Benchmark against ADAM, gfortran, one CPU core
template  = template-bench template-gnu template-release

# the compact operators (right side + line solve) against the explicit ones of equal order (#2, L6)
[bench-compact-nvf-oac]
help      = Benchmark of the compact operators, nvfortran, OpenACC on the GPU of compute capability $GPU_CC
template  = template-bench-compact template-nvf template-release
cflags    = -c -acc -gpu=$GPU_CC -Minfo=accel
lflags    = -acc -gpu=$GPU_CC

[bench-compact-nvf]
help      = Benchmark of the compact operators, nvfortran, one CPU core
template  = template-bench-compact template-nvf template-release

[bench-compact-gnu]
help      = Benchmark of the compact operators, gfortran, one CPU core
template  = template-bench-compact template-gnu template-release

# ── documentation examples: every program of docs/examples/src into exe-examples/, run and checked against
# docs/examples/output by scripts/run_examples.sh ──
[examples-gnu]
help      = Documentation examples, gfortran, optimised (scripts/run_examples.sh)
template  = template-examples template-gnu template-release

# the same programs in single precision, for the outputs docs/examples/output/<name>-r4.txt (scripts/run_examples.sh)
[examples-gnu-r4]
help      = Documentation examples, gfortran, optimised, R4P (scripts/run_examples.sh, outputs <name>-r4.txt)
template  = template-examples template-gnu template-release template-r4
build_dir = exe-examples-r4/
# the left template (template-examples) would win the preproc: both macros here
preproc   = -D_R_P_IS_R4P -DFUNDAL_NO_MPI

# ── single precision (R4P): PENF's R_P chosen by -D_R_P_IS_R4P for GIDEON and PENF alike ──
# Own build directories and library name, so that an R4P build never mixes with the R8P one.
[static-gnu-r4]
help      = Static library, gfortran, optimised, single precision (R_P = R4P)
template  = template-r4 template-lib-static template-gnu template-release
build_dir = lib/gnu/static-r4/
output    = libgideon_r4.a

[shared-gnu-r4]
help      = Shared library, gfortran, optimised, single precision (R_P = R4P)
template  = template-r4 template-lib-shared template-gnu template-release
cflags    = -c -fPIC $STD_GNU
build_dir = lib/gnu/shared-r4/
output    = libgideon_r4.so

[static-nvf-r4]
help      = Static library, nvfortran, optimised, single precision (R_P = R4P)
template  = template-r4 template-lib-static template-nvf template-release
build_dir = lib/nvf/static-r4/
output    = libgideon_r4.a

[shared-nvf-r4]
help      = Shared library, nvfortran, optimised, single precision (R_P = R4P)
template  = template-r4 template-lib-shared template-nvf template-release
cflags    = -c -fPIC
build_dir = lib/nvf/shared-r4/
output    = libgideon_r4.so

[static-intel-r4]
help      = Static library, ifx, optimised, single precision (R_P = R4P)
template  = template-r4 template-lib-static template-intel-release template-intel
build_dir = lib/intel/static-r4/
output    = libgideon_r4.a

[shared-intel-r4]
help      = Shared library, ifx, single precision (R_P = R4P)
template  = template-r4 template-lib-shared template-intel
cflags    = -c -fPIC -O3 $STD_INT $FP_INT
build_dir = lib/intel/shared-r4/
output    = libgideon_r4.so

[tests-gnu-r4]
help      = Tests, gfortran, optimised, single precision (R_P = R4P)
template  = template-r4-tests template-tests template-gnu template-release

[tests-gnu-debug-r4]
help      = Tests, gfortran, all checks on, single precision (R_P = R4P)
template  = template-r4-tests template-tests template-gnu template-debug

[tests-nvf-r4]
help      = Tests, nvfortran, optimised, CPU, single precision (R_P = R4P)
template  = template-r4-tests template-tests template-nvf template-release
cflags    = -c $FP_NVF

[tests-nvf-oac-r4]
help      = Tests, nvfortran, OpenACC on the GPU of compute capability $GPU_CC, single precision (R_P = R4P)
template  = template-r4-tests template-tests template-nvf template-release
cflags    = -c -acc -gpu=$GPU_CC -Minfo=accel $FP_NVF
lflags    = -acc -gpu=$GPU_CC
# the R4P exclusions: ADAM's code
exclude   = src/tests/adam_fdv_operators_library.F90
            src/tests/adam_fnl_fdv_operators_library.F90
            src/tests/gideon_test_adam.F90
# the time integrator of the programs that use it: SELAH built for the host (their fields are host memory),
# linked; under -acc without its device build SELAH's directives would not compile (FUNDAL's host branch)
dependon  = fobos:static-selah-nvf-r4
exclude_dirs = $EXDIRS src/third_party/SELAH/ src/third_party/FUNDAL/

[tests-intel-r4]
help      = Tests, ifx, optimised, single precision (R_P = R4P)
template  = template-r4-tests template-tests template-intel-release template-intel

# ── quadruple precision (R16P): a host-only verification build, gfortran (PENF_R16P); the orders of every kernel are
# measured here, where double precision's round-off hides those of the widest stencils ──
[tests-gnu-r16]
help      = Tests, gfortran, optimised, quadruple precision (R_P = R16P): the verification of the orders
template  = template-r16-tests template-tests template-gnu template-release

# ── templates: left wins when a mode lists several, so the role template (lib, tests) comes first ──
[template-base]
src             = src/lib/
exclude_dirs    = $EXDIRS
obj_dir         = obj/
mod_dir         = mod/
cflags_heritage = True
colors          = True
jobs            = 8

[template-gnu]
template = template-base
compiler = gnu
cflags   = -c $STD_GNU

[template-nvf]
template = template-base
compiler = nvfortran
cflags   = -c

[template-intel]
template = template-base
compiler = intel_nextgen
cflags   = -c $STD_INT $FP_INT

[template-release]
build_profile = release

# ifx without the release profile: its -ipo writes IR objects that the link (FoBiS passes no -ipo to it) and a plain
# ar archive cannot read
[template-intel-release]
cflags = -c -O3 $STD_INT $FP_INT

[template-debug]
build_profile = debug

[template-lib-static]
target    = src/lib/gideon.F90
mklib     = static
output    = libgideon.a

[template-lib-shared]
target    = src/lib/gideon.F90
mklib     = shared
output    = libgideon.so

[template-bench]
src       = src/lib/ src/bench/ src/tests/
build_dir = exe-bench/
target    = src/bench/gideon_bench_adam.F90
output    = gideon_bench_adam

[template-bench-compact]
src       = src/lib/ src/bench/
build_dir = exe-bench/
target    = src/bench/gideon_bench_compact.F90
output    = gideon_bench_compact

[template-examples]
src       = src/lib/ docs/examples/src/
build_dir = exe-examples/
# cookbook_dissipation takes its time integrator from SELAH, whose kernels include FUNDAL's fundal.H; FUNDAL's MPI
# handler is compiled empty
include   = src/third_party/FUNDAL/src/lib/
preproc   = -DFUNDAL_NO_MPI

[template-r4]
preproc = -D_R_P_IS_R4P

[template-r4-tests]
template  = template-r4
# the left template wins: template-r4's preproc would drop template-tests' -DFUNDAL_NO_MPI
preproc   = -D_R_P_IS_R4P -DFUNDAL_NO_MPI
build_dir = exe-r4/
# ADAM's code and the comparison with it are R8P only
exclude   = src/tests/adam_fdv_operators_library.F90 src/tests/adam_fnl_fdv_operators_library.F90 src/tests/gideon_test_adam.F90

[template-r16-tests]
preproc   = -DPENF_R16P -D_R_P_IS_R16P -DFUNDAL_NO_MPI
build_dir = exe-r16/
# ADAM's code and the comparison with it are R8P only; gideon_vv_advection takes its time integrator from SELAH,
# which refuses R16P (SELAH issue #2, decision D2): the quadruple-precision mode verifies the operators' orders
exclude   = src/tests/adam_fdv_operators_library.F90 src/tests/adam_fnl_fdv_operators_library.F90 src/tests/gideon_test_adam.F90
            src/tests/gideon_vv_advection.F90

[template-tests]
src       = src/lib/ src/tests/
build_dir = exe/
# SELAH's kernels include FUNDAL's fundal.H; FUNDAL's MPI handler is compiled empty (the tests are per rank)
include   = src/third_party/FUNDAL/src/lib/
preproc   = -DFUNDAL_NO_MPI

# ── rules ────────────────────────────────────────────────────────────────────
[rule-makecoverage]
help   = Build the tests with coverage instrumentation and run them
rule_1 = fobis clean --mode tests-gnu-coverage
rule_2 = fobis build --mode tests-gnu-coverage
rule_3 = bash scripts/run_tests.sh

[rule-makecoverage-analysis]
help   = What CI runs: coverage (the badge JSON docs/public/coverage.json), R16P tests, generator, examples, docs check
rule_1 = fobis rule --ex makecoverage
rule_2 = bash scripts/compute-coverage.sh
# then the tests in quadruple precision: the orders of every kernel, observed (gideon_test_order)
rule_3 = fobis build --mode tests-gnu-r16
rule_4 = bash scripts/run_tests.sh --exe-dir exe-r16
# then what the documentation shows: the generated sources up to date, the examples' outputs, the pages against the code
rule_5 = python3 scripts/gen_gideon.py --check
rule_6 = bash scripts/run_examples.sh
rule_7 = python3 scripts/check_docs.py

[rule-makedoc]
help   = Build the documentation: formal API + VitePress
rule_1 = cd docs && npm install --no-audit --no-fund && npm run docs:build

[rule-clean]
help = Remove build products and documentation artefacts
rule = rm -rf exe/ exe-r4/ exe-r16/ exe-bench/ exe-examples/ exe-examples-r4/ lib/ obj/ mod/ docs/api/ docs/.vitepress/dist/ docs/.vitepress/cache/ docs/public/coverage.json
